<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Producer Toy ProVerb</title>
    <options customize="always" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- Choice Definitions -->
    <choices-outline>
        <line choice="choice_vst3"/>
        <line choice="choice_au"/>
        <line choice="choice_aax"/>
    </choices-outline>

    <!-- VST3 Choice -->
    <choice id="choice_vst3"
            title="VST3 Plugin"
            description="Installs Producer Toy ProVerb VST3 into /Library/Audio/Plug-Ins/VST3 (Compatible with FL Studio, Ableton Live, Cubase, Studio One, Reaper)"
            start_selected="true">
        <pkg-ref id="com.producertoy.proverb.vst3"/>
    </choice>

    <!-- Audio Unit (AU) Choice -->
    <choice id="choice_au"
            title="Audio Unit (AU) Plugin"
            description="Installs Producer Toy ProVerb AU Component into /Library/Audio/Plug-Ins/Components (Required for Logic Pro, GarageBand, Ableton Live)"
            start_selected="true">
        <pkg-ref id="com.producertoy.proverb.au"/>
    </choice>

    <!-- AAX Choice (Pro Tools - optional/proprietary SDK) -->
    <choice id="choice_aax"
            title="Avid AAX Plugin"
            description="Installs Producer Toy ProVerb AAX into /Library/Application Support/Avid/Audio/Plug-Ins (Required for Avid Pro Tools)"
            start_selected="false"
            start_visible="false">
        <pkg-ref id="com.producertoy.proverb.aax"/>
    </choice>

    <!-- Package References -->
    <pkg-ref id="com.producertoy.proverb.vst3" version="1.0.0" onConclusion="none">ProVerb_VST3.pkg</pkg-ref>
    <pkg-ref id="com.producertoy.proverb.au"   version="1.0.0" onConclusion="none">ProVerb_AU.pkg</pkg-ref>
    <pkg-ref id="com.producertoy.proverb.aax"  version="1.0.0" onConclusion="none">ProVerb_AAX.pkg</pkg-ref>
</installer-gui-script>
